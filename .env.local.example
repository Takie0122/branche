# Google Cloud Console で「Maps JavaScript API」を有効化し、
# API キーを発行して制限（HTTP リファラー: localhost / 本番ドメイン）を設定してください。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ホームのスワイプカード用・Google 店舗写真（Places API）。
# Cloud Console で「Places API」を有効化し、Find Place + Place Details + Place Photo が使えるキーにする。
# 本番ではこのキーをサーバー専用（IP 制限など）にし、NEXT_PUBLIC には載せないことを推奨。
# 未設定時は従来どおり Unsplash のフォールバック画像のみ。
GOOGLE_PLACES_API_KEY=
